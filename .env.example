# Copy this file to .env and replace every development-only value.
COMPOSE_PROJECT_NAME=akis

POSTGRES_IMAGE=postgres:18.6-bookworm
POSTGRES_DB=akis_metadata
POSTGRES_USER=akis_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

AKIS_DB_URL=jdbc:postgresql://localhost:5432/akis_metadata
AKIS_DB_USERNAME=akis_app
AKIS_DB_PASSWORD=change-me
AKIS_DB_POOL_SIZE=5
AKIS_SERVER_PORT=8080
