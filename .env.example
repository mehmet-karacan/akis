# Copy this file to .env and replace every development-only value.
COMPOSE_PROJECT_NAME=akis

POSTGRES_IMAGE=postgres:18.6-bookworm
POSTGRES_DB=akis_metadata
POSTGRES_USER=akis_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

AKIS_DB_URL=jdbc:postgresql://localhost:5432/akis_metadata
AKIS_DB_USERNAME=akis_app
AKIS_DB_PASSWORD=change-me
AKIS_DB_POOL_SIZE=5
AKIS_SERVER_PORT=8080
AKIS_SERVER_ADDRESS=127.0.0.1

# Manual requests create durable queued runs only. The worker remains fail-closed
# until worker/reconciliation orchestration and crash gates are complete.
AKIS_EXECUTION_ACCEPT_MANUAL_REQUESTS=false
AKIS_EXECUTION_WORKER_ENABLED=false
AKIS_EXECUTION_PROCEDURE_RUNTIME_ENABLED=false

# Local-only API authentication. Replace the password and never use development
# mode outside loopback. Production uses oidc and requires AKIS_OIDC_ISSUER_URI.
AKIS_SECURITY_MODE=development
AKIS_DEV_USERNAME=developer
AKIS_DEV_PASSWORD=change-me
AKIS_OIDC_ISSUER_URI=
AKIS_OIDC_AUDIENCE=

# Oracle 19c Phase 0 probe. Use EZConnect URLs so the network preflight can
# identify host and port. Keep real values only in .env.
AKIS_ORACLE_EXPECTED_MAJOR=19
AKIS_ORACLE_SOURCE_URL=jdbc:oracle:thin:@//source-host:1521/source-service
AKIS_ORACLE_SOURCE_USERNAME=source_readonly
AKIS_ORACLE_SOURCE_PASSWORD=change-me
# The launcher converts the local username/password above into the JSON value
# expected by an ENV secret reference. Only the variable name is stored in Akis.
AKIS_ORACLE_SOURCE_CREDENTIAL_REFERENCE=AKIS_ORACLE_SOURCE_CREDENTIAL
AKIS_ORACLE_TARGET_URL=jdbc:oracle:thin:@//target-host:1521/target-service
AKIS_ORACLE_TARGET_USERNAME=target_probe
AKIS_ORACLE_TARGET_PASSWORD=change-me
AKIS_ORACLE_TARGET_CREDENTIAL_REFERENCE=AKIS_ORACLE_TARGET_CREDENTIAL
AKIS_ORACLE_CONNECT_TIMEOUT_MS=10000
AKIS_ORACLE_READ_TIMEOUT_MS=30000
AKIS_ORACLE_SOURCE_OWNER=SOURCE_OWNER
AKIS_ORACLE_SOURCE_TABLE=SOURCE_TABLE
AKIS_ORACLE_TARGET_OWNER=TARGET_OWNER
AKIS_ORACLE_TARGET_TABLE=STG_SOURCE_TABLE
AKIS_ORACLE_COPY_ENABLED=false
AKIS_ORACLE_BATCH_SIZE=100
